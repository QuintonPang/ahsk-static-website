---
import Site from '../layouts/Site.astro';
import ContactForm from '../components/ContactForm.astro';
const address = 'H-7-3 (3rd Floor), Pusat Perdagangan Bandar Bukit Jalil, Persiaran Jalil 2, 57000 Kuala Lumpur';
const mapQuery = encodeURIComponent(address);

---
<Site title="Contact">
  <section class="wrap interior contact">
    <div class="prose">
      <h1>Contact</h1>
      <address class="office-details">
        <p>H-7-3 (3rd Floor),<br />Pusat Perdagangan Bandar Bukit Jalil,<br />Persiaran Jalil 2,<br />57000 Kuala Lumpur.</p>
        <p>Contact No: <a href="tel:+60327753133">03-2775 3133</a></p>
      </address>
      <div class="office-map">
        <iframe title="Google Map showing the Ang & Koh office address" src={`https://maps.google.com/maps?q=${mapQuery}&output=embed`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        <a class="text-link" href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
      </div>
    </div>
    <ContactForm />
  </section>
</Site>
