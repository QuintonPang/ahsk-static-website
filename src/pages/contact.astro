---
import Site from '../layouts/Site.astro';
import Banner from '../components/Banner.astro';
import ContactForm from '../components/ContactForm.astro';
---
<Site title="Contact">
  <Banner variant="contact" />
  <section class="interior wrap split contact">
    <div>
      <div class="contact-icons" aria-label="Social links placeholder"><span aria-hidden="true">f</span><span aria-hidden="true">𝕏</span><span aria-hidden="true">▶</span></div>
      <h1 class="eyebrow">Contact</h1>
      <address>Sample office address<br />Jalan Tun Razak, Kuala Lumpur</address>
      <ul class="contact-list"><li>Telephone placeholder</li><li>Fax placeholder</li><li>Email placeholder</li></ul>
      <h2 class="eyebrow">Business hours</h2>
      <p>Sample hours · Monday to Friday, 08:00–18:00</p>
    </div>
    <ContactForm />
  </section>
  <div class="wrap contact-visuals">
    <div class="map-preview"><span>Map placeholder</span><small>External map integration is disabled in this demo.</small></div>
  </div>
</Site>
