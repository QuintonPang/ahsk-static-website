---
import Site from '../layouts/Site.astro';
import { people, eventImageUrl } from '../content';


---
<Site title="People">
  <section class="wrap interior" aria-labelledby="people-heading">
    <div class="people-intro">
      <h1 id="people-heading">People</h1>
      {people.length > 0 && people.every(person => person.sample) && <p>These fictional profiles show how the Ang &amp; Koh team directory could look.</p>}
    </div>
    {people.length === 0 && <p>Team details will be available soon.</p>}
    <ul class="people-grid">
      {people.map(person => <li class="person-card" id={person.slug}>
        {person.image?.file
          ? <img class="person-photo" src={eventImageUrl(person.image.file)} alt={person.image.alt || person.name} loading="lazy" width="600" height="500" />
          : <div class="person-mark" aria-hidden="true">{person.initials?.trim() || person.name.split(/\s+/).map(part => part[0]).slice(0, 2).join('')}</div>}
        <div class="person-details">
          <p class="person-role">{person.role}</p>
          <h2>{person.name}</h2>
          <p>{person.bio}</p>
        </div>
      </li>)}
    </ul>
  </section>
</Site>
