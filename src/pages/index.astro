---
import Site from '../layouts/Site.astro';
import PracticeList from '../components/PracticeList.astro';
import { events, url } from '../content';
import EventCards from '../components/EventCards.astro';
const latestEvents = [...events]
  .sort((left, right) => (right.date || '').localeCompare(left.date || '') || left.order - right.order)
  .slice(0, 4);
---
<Site title="Home">
  <div class="concept-strip"><div class="wrap">Ang &amp; Koh website concept</div></div>
  <section class="hero">
    <img class="hero-image" src={url('assets/home-colonnade.webp')} alt="" fetchpriority="high" />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>Find a starting point for your legal matter.</h1>
        <p>Explore common business, property, and contract matters and see what to prepare for a first conversation.</p>
        <a class="button" href={url('contact/')}>Contact <span class="chevron" aria-hidden="true"></span></a>
      </div>
      <div class="hero-practices">
        <h2>Practice areas</h2>
        <PracticeList />
      </div>
    </div>
  </section>
  <section class="wrap latest-events" aria-labelledby="latest-events-heading">
    <div class="latest-events-heading">
      <h2 id="latest-events-heading">Latest events</h2>
      <a class="text-link" href={url('news-events/')}>More events <span aria-hidden="true">→</span></a>
    </div>
    <EventCards items={latestEvents} />
    {latestEvents.length === 0 && <p>Events will be announced here.</p>}
  </section>
</Site>
