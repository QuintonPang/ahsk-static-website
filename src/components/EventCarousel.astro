---
import { updates, url } from '../content';
const events = updates.filter(item => item.kind === 'event');
const images = [
  { file: 'assets/workshop-table.webp', alt: 'Hands taking notes around a workshop table' },
  { file: 'assets/office-atrium.webp', alt: 'A spacious office atrium with natural light' },
  { file: 'assets/home-colonnade.webp', alt: 'Sunlit stone columns beside a shaded walkway' },
];
---
{events.length > 0 && <section class="wrap event-carousel" aria-labelledby="carousel-heading" aria-roledescription="carousel">
  <div class="carousel-heading">
    <h2 id="carousel-heading">News &amp; Events</h2>

  </div>
  <div class="carousel-track" id="event-slides" tabindex="0" aria-label="Event highlights. Swipe or use the arrow keys to browse.">
    {events.map((event, index) => {
      const image = event.image?.file ? event.image : images[index % images.length];
      return <article class="carousel-slide" role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${events.length}`}>
        <img src={url(image.file)} alt={image.alt} loading="lazy" width="900" height="600" />
        <div class="carousel-copy">
          {event.sample && <p>Example event</p>}
          <h3>{event.title}</h3>
          <p>{event.summary}</p>
          <a class="button" href={url('news-events/' + event.slug + '/')}>View event <span class="chevron" aria-hidden="true"></span></a>
        </div>
      </article>;
    })}
  </div>
  <div class="carousel-footer">
    <p class="carousel-position" aria-live="polite" aria-atomic="true" data-position>1 of {events.length}</p>
    {events.length > 1 && <div class="carousel-controls" hidden>
      <button type="button" data-previous aria-label="Previous event" aria-controls="event-slides"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m10 5-7 7 7 7M3 12h18" /></svg><span>Previous</span></button>
      <button type="button" data-next aria-label="Next event" aria-controls="event-slides"><span>Next</span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m14 5 7 7-7 7M3 12h18" /></svg></button>
    </div>}
  </div>
</section>}
<script>
  document.querySelectorAll<HTMLElement>('.event-carousel').forEach(carousel => {
    const track = carousel.querySelector<HTMLElement>('.carousel-track')!;
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.carousel-slide'));
    const previous = carousel.querySelector<HTMLButtonElement>('[data-previous]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-next]');
    const position = carousel.querySelector<HTMLElement>('[data-position]')!;
    const controls = carousel.querySelector<HTMLElement>('.carousel-controls');
    let current = 0;

    function update() {
      current = Math.round(track.scrollLeft / track.clientWidth);
      if (previous) previous.disabled = current === 0;
      if (next) next.disabled = current >= slides.length - 1;
      position.textContent = `${current + 1} of ${slides.length}`;
    }
    function move(step: number) {
      const target = Math.max(0, Math.min(slides.length - 1, current + step));
      track.scrollTo({
        left: target * track.clientWidth,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
      });
    }

    previous?.addEventListener('click', () => move(-1));
    next?.addEventListener('click', () => move(1));
    track.addEventListener('scroll', update, { passive: true });
    track.addEventListener('keydown', event => {
      if (event.target !== track || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
      event.preventDefault();
      move(event.key === 'ArrowRight' ? 1 : -1);
    });
    new ResizeObserver(update).observe(track);
    if (controls) controls.hidden = false;
    carousel.classList.add('is-enhanced');
    update();
  });
</script>
