---
import { news, url, formatDate } from '../content';
interface Props { items: typeof news }
const { items } = Astro.props;
---
<div class="news-grid">
  {items.map(item => <article class="news-card">
    {item.photo && <a href={url(item.slug + '/')} tabindex="-1" aria-hidden="true" class="news-photo"><img src={url('assets/' + item.photo + '.webp')} alt="" loading="lazy" /><span class="image-note">Image placeholder</span></a>}
    <div class="news-copy">
      <h3><a href={url(item.slug + '/')}>{item.title}</a></h3>
      <p>{item.summary}</p>
      <time datetime={item.date}><span aria-hidden="true">◷</span> {formatDate(item.date)}</time>
    </div>
  </article>)}
</div>
