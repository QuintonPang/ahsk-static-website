---
import { url } from '../content';
const slides = [
  { photo: 'slate', title: 'Recognition', subtitle: 'This space is reserved for approved award details and a short description of the recognition.', award: true },
  { photo: 'skyline', title: 'Commercial Lawyers', subtitle: 'Kuala Lumpur' },
  { photo: 'gavel', title: 'Dispute Resolution', subtitle: 'Civil and commercial matters' },
  { photo: 'conference', title: 'Industry Recognition', subtitle: 'Award artwork placeholder' },
  { photo: 'columns', title: 'Conveyancing', subtitle: 'Commercial & Corporate' },
];
---
<section class="carousel" aria-roledescription="carousel" aria-label="Firm highlights">
  {slides.map((slide, index) => <div class="slide" hidden={index !== 0} role="group" aria-roledescription="slide" aria-label={index + 1 + ' of ' + slides.length}>
    <img src={url('assets/' + slide.photo + '.webp')} alt="" fetchpriority={index === 0 ? 'high' : 'auto'} loading={index === 0 ? 'eager' : 'lazy'} />
    <div class="slide-copy">
      {slide.award && <div class="award-art"><span>Firm<br />Awards</span><i aria-hidden="true"></i><span>Award placeholder</span></div>}
      {!slide.award && <h2>{slide.title}</h2>}
      <p>{slide.subtitle}</p>
    </div>
    <span class="image-note">Image placeholder</span>
  </div>)}
  <button class="slide-prev" type="button" aria-label="Previous slide">‹</button>
  <button class="slide-next" type="button" aria-label="Next slide">›</button>
  <button class="slide-motion" type="button">Pause slideshow</button>
  <span class="sr-only carousel-status" aria-live="polite"></span>
</section>
<script>
  const carousel = document.querySelector<HTMLElement>('.carousel')!;
  const slides = [...carousel.querySelectorAll<HTMLElement>('.slide')];
  const motion = carousel.querySelector<HTMLButtonElement>('.slide-motion')!;
  const status = carousel.querySelector<HTMLElement>('.carousel-status')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  let current = 0;
  let timer: number | undefined;
  let playing = !reduced.matches;

  function show(next: number, announce = false) {
    slides[current].hidden = true;
    current = (next + slides.length) % slides.length;
    slides[current].hidden = false;
    if (announce) status.textContent = 'Slide ' + (current + 1) + ' of ' + slides.length;
  }

  function restart() {
    window.clearInterval(timer);
    motion.textContent = playing ? 'Pause slideshow' : 'Play slideshow';
    if (playing && !carousel.matches(':hover, :focus-within') && !document.hidden) {
      timer = window.setInterval(() => show(current + 1), 6500);
    }
  }

  carousel.querySelector('.slide-prev')!.addEventListener('click', () => show(current - 1, true));
  carousel.querySelector('.slide-next')!.addEventListener('click', () => show(current + 1, true));
  motion.addEventListener('click', () => { playing = !playing; restart(); });
  ['mouseenter', 'mouseleave', 'focusin'].forEach(event => carousel.addEventListener(event, restart));
  carousel.addEventListener('focusout', () => window.setTimeout(restart));
  document.addEventListener('visibilitychange', restart);
  reduced.addEventListener('change', () => { playing = !reduced.matches; restart(); });
  restart();
</script>
