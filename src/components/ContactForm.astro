<form class="contact-form" aria-describedby="demo-note">
  <p id="demo-note">Demonstration form. Entries stay on this page. Please use sample information.</p>
  <label><span>Your Name <span aria-hidden="true">*</span></span><input placeholder="Your Name" type="text" required maxlength="100" pattern=".*\S.*" /></label>
  <label><span>Your Email <span aria-hidden="true">*</span></span><input placeholder="Your Email" type="email" required maxlength="254" /></label>
  <label><span>Your Phone Numbers</span><input placeholder="Your Phone Numbers" type="tel" maxlength="40" /></label>
  <label><span>Your Message <span aria-hidden="true">*</span></span><textarea placeholder="Your Message" rows="6" required maxlength="3000"></textarea></label>
  <button class="button" type="button" data-preview disabled>Validate demo</button>
  <p role="status" data-status></p>
  <noscript><p>Enable JavaScript to check this demonstration form.</p></noscript>
</form>
<script>
  const form = document.querySelector<HTMLFormElement>('.contact-form')!;
  const button = form.querySelector<HTMLButtonElement>('[data-preview]')!;
  const message = form.querySelector<HTMLTextAreaElement>('textarea')!;
  const status = form.querySelector<HTMLElement>('[data-status]')!;

  function checkDemo() {
    status.textContent = '';
    message.setCustomValidity(message.value.trim() ? '' : 'Enter a sample message.');
    if (form.reportValidity()) status.textContent = 'Validation passed. Your entries stayed on this page.';
  }

  form.addEventListener('submit', event => {
    event.preventDefault();
    checkDemo();
  });
  form.addEventListener('input', () => {
    message.setCustomValidity('');
    status.textContent = '';
  });
  button.type = 'submit';
  button.disabled = false;
</script>
